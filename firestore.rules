rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'isOnline']) &&
             data.keys().hasOnly(['displayName', 'avatarColor', 'isOnline', 'lastSeen']) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 80)) &&
             data.isOnline is bool &&
             (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 50));
    }

    // Encrypted Chat Message Validation
    function isValidChatMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'type', 'ciphertext', 'iv']) &&
             data.keys().hasOnly(['senderId', 'senderName', 'type', 'ciphertext', 'iv', 'timestamp', 'expiresAt', 'disappearingSeconds']) &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100 &&
             data.type in ['text', 'file', 'audio-note', 'system'] &&
             data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 2000000 &&
             data.iv is string && data.iv.size() > 0 && data.iv.size() <= 64 &&
             (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 50)) &&
             (!('expiresAt' in data) || (data.expiresAt is number)) &&
             (!('disappearingSeconds' in data) || (data.disappearingSeconds is number));
    }

    // WebRTC Signaling Validation
    function isValidSignal(data) {
      return data.keys().hasAll(['senderId', 'targetId', 'type', 'data']) &&
             data.keys().hasOnly(['senderId', 'targetId', 'type', 'data', 'timestamp']) &&
             data.senderId == request.auth.uid &&
             isValidId(data.targetId) &&
             data.type in ['sdp-offer', 'sdp-answer', 'ice-candidate', 'call-request', 'call-accept', 'call-reject', 'call-hangup', 'disappearing-timer'] &&
             data.data is string && data.data.size() <= 50000 &&
             (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 50));
    }

    // Screenshot Alert Validation
    function isValidAlert(data) {
      return data.keys().hasAll(['senderId', 'senderName']) &&
             data.keys().hasOnly(['senderId', 'senderName', 'timestamp']) &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() <= 100 &&
             (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 50));
    }

    // User collection rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
    }

    // Conversation subcollections
    match /conversations/{conversationId} {
      allow read: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }

      match /signals/{signalId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(conversationId) && isValidId(signalId) && isValidSignal(incoming());
        allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || existing().targetId == request.auth.uid);
      }

      match /alerts/{alertId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(conversationId) && isValidId(alertId) && isValidAlert(incoming());
      }
    }
  }
}
